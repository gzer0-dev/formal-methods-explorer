-- Needham–Schroeder 公開鍵プロトコルと侵入者（src/topic/cspSecurityProtocol.ts と同じモデル）。照合は cspSecurityProtocol.mjs。
-- 文: M1.n.x.k = {n,x}pk(k)、M2.n1.n2.k = {n1,n2}pk(k)、M2L.n1.n2.r.k = {n1,n2,r}pk(k)（Lowe の直し）、M3.n.k = {n}pk(k)
datatype Agent = A | B | I
datatype Nonce = Na | Nb | Ni
datatype Msg = M1.Nonce.Agent.Agent | M2.Nonce.Nonce.Agent | M2L.Nonce.Nonce.Agent.Agent | M3.Nonce.Agent
datatype Version = Orig | Lowe

channel send, recv : Agent.Agent.Msg
channel running, commit : Agent.Agent

msg2(v, n1, n2, r, k) = if v == Lowe then M2L.n1.n2.r.k else M2.n1.n2.k

keyOf(M1.n.x.k) = k
keyOf(M2.a.b.k) = k
keyOf(M2L.a.b.r.k) = k
keyOf(M3.n.k) = k

noncesOf(M1.n.x.k) = {n}
noncesOf(M2.a.b.k) = {a, b}
noncesOf(M2L.a.b.r.k) = {a, b}
noncesOf(M3.n.k) = {n}

-- A は相手を選んで1回だけ始める。B は1回だけ応じ、1通目に書かれた名前を相手と信じる。
Initiator(v, P) = [] p : P @ send.A.p.M1.Na.A.p -> Init2(v, p)
Init2(v, p) = [] n : Nonce @ recv.A.p.msg2(v, Na, n, p, A) -> running.A.p -> send.A.p.M3.n.p -> STOP
Responder(v) = [] x : {A, I} @ [] n : Nonce @
  recv.B.x.M1.n.x.B -> send.B.x.msg2(v, n, Nb, B, x) -> recv.B.x.M3.Nb.B -> commit.B.x -> STOP

-- 侵入者＝ネットワーク。KN は知っている nonce、KH は開けずに覚えた暗号文。pkI の文だけ開けられる。
learnN(KN, m) = if keyOf(m) == I then union(KN, noncesOf(m)) else KN
learnH(KH, m, rep) = if keyOf(m) != I and rep then union(KH, {m}) else KH
canProduce(KN, KH, m) = member(m, KH) or empty(diff(noncesOf(m), KN))

-- 侵入者が相手にするのは、正直な A と B が送る文・受け付ける文だけ（それ以外は同期の相手がいないので足りる）。
SendTuples(v, P) = union(union({(A, p, M1.Na.A.p) | p <- P}, {(A, p, M3.n.p) | p <- P, n <- Nonce}),
                         {(B, x, msg2(v, n, Nb, B, x)) | x <- {A, I}, n <- Nonce})
RecvTuples(v, P) = union(union({(A, p, msg2(v, Na, n, p, A)) | p <- P, n <- Nonce}, {(B, x, M1.n.x.B) | x <- {A, I}, n <- Nonce}),
                         {(B, x, M3.Nb.B) | x <- {A, I}})

Intruder(v, P, rep, KN, KH) =
  ([] (x, y, m) : SendTuples(v, P) @ send.x.y.m -> Intruder(v, P, rep, learnN(KN, m), learnH(KH, m, rep)))
  [] ([] (x, y, m) : RecvTuples(v, P) @ canProduce(KN, KH, m) & recv.x.y.m -> Intruder(v, P, rep, KN, KH))

System(v, P, rep) = (Initiator(v, P) ||| Responder(v)) [| {| send, recv |} |] Intruder(v, P, rep, {Ni}, {})

-- 認証: commit.B.A の前に running.A.B がある。ほかのイベントを隠して比べる。
-- 隠さずに全イベントの監視役で比べる形（サイトの checkAuthentication）は、ProB が Events 全体の選択を読めずに落ちたので、ここでは隠す形だけにした。
AuthSpec = running.A.B -> commit.B.A -> STOP
Observed(v, P, rep) = System(v, P, rep) \ diff(Events, {running.A.B, commit.B.A})

NSOriginal = Observed(Orig, {B, I}, true)
NSLowe = Observed(Lowe, {B, I}, true)
NSNoReplay = Observed(Orig, {B, I}, false)
NSOnlyB = Observed(Orig, {B}, true)
