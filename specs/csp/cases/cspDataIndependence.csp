-- データ独立性（src/topic/cspDataIndependence.ts と同じモデル）。値の種類 n を変えて、サイトの検査器の結果と ProB を照合する。
channel in, out : {0..3}

Vals(n) = {0..n-1}

Fifo(q, n) = (#q < 2 & in?x:Vals(n) -> Fifo(q ^ <x>, n)) [] (#q > 0 & out!head(q) -> Fifo(tail(q), n))
Stack(s, n) = (#s < 2 & in?x:Vals(n) -> Stack(<x> ^ s, n)) [] (#s > 0 & out!head(s) -> Stack(tail(s), n))

channel mid : {0..3}
Cell1(n) = in?x:Vals(n) -> mid!x -> Cell1(n)
Cell2(n) = mid?x:Vals(n) -> out!x -> Cell2(n)
CellPair(n) = (Cell1(n) [| {| mid |} |] Cell2(n)) \ {| mid |}

-- 重複よけ: 直近に渡した値を k 個まで覚え、覚えている値なら捨てる。新しい値は渡して覚え、あふれたら最も古いものを忘れる。
keepLast(s, k) = if #s > k then keepLast(tail(s), k) else s
Dedup(mem, k, n) = in?x:Vals(n) ->
  (if elem(x, mem) then Dedup(mem, k, n) else out!x -> Dedup(keepLast(mem ^ <x>, k), k, n))
-- 仕様: どの値も高々1回しか渡さない。初めての値は渡しても渡さなくてもよい。
Unique(passed, n) = in?x:Vals(n) ->
  (if member(x, passed) then Unique(passed, n)
   else (out!x -> Unique(union(passed, {x}), n)) |~| Unique(passed, n))

FifoSpec1 = Fifo(<>, 1)
FifoSpec2 = Fifo(<>, 2)
FifoSpec3 = Fifo(<>, 3)
CellPair1 = CellPair(1)
CellPair2 = CellPair(2)
CellPair3 = CellPair(3)
Stack1 = Stack(<>, 1)
Stack2 = Stack(<>, 2)
Stack3 = Stack(<>, 3)
Unique2 = Unique({}, 2)
Unique3 = Unique({}, 3)
Dedup2 = Dedup(<>, 2, 2)
Dedup3 = Dedup(<>, 2, 3)

-- 3つ目の値 2 を 1 に付け替える（src/topic/cspDataIndependence.ts の collapseTopValue と同じ）。
Stack3Collapsed = Stack3[[in.2 <- in.1, out.2 <- out.1]]
Dedup3Collapsed = Dedup3[[in.2 <- in.1, out.2 <- out.1]]
