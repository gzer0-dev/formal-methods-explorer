{
  "name": "formal-methods-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "形式手法（モデル検査・仕様・性質ベーステスト）を1ステップずつ図で学ぶサイト",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:layers": "node scripts/check-layers.mjs",
    "check:content": "vitest run src/topicContent.test.ts src/lessonFiles.test.ts",
    "check:site": "node scripts/check-site.mjs",
    "verify": "npm run typecheck && npm run check:layers && npm run lint && npm run format && npm test && npm run build && npm run check:site",
    "dump:text": "node scripts/dump-text.mjs",
    "check:tla": "node specs/tla/check-tlc.mjs",
    "check:alloy": "node specs/alloy/check-alloy.mjs",
    "check:csp": "node specs/csp/check-prob.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
